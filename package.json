{
  "name": "wireframe-tanks",
  "version": "0.0.0",
  "private": true,
  "description": "A wireframe tank game for the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=site/src/core/** --test-coverage-lines=90 \"test/unit/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.node.json",
    "size": "node scripts/check-size.js",
    "smoke": "node scripts/smoke.js",
    "serve": "node scripts/serve.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run size",
    "hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "typescript": "7.0.2"
  }
}
